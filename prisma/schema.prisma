generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(uuid())
  username      String      @unique
  password      String
  employeeId    String?     @unique
  isActive      Boolean     @default(true)
  createdById   String?
  updatedById   String?
  groups        UserGroup[]
  authoredDocs  Document[]  @relation("AuthorDocs")
  confirmedDocs Document[]  @relation("ConfirmedDocs")
  auditLogs     AuditLog[]
  positionId    String?
  position      Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Group {
  id          String            @id @default(uuid())
  name        String            @unique
  description String?
  isActive    Boolean           @default(true)
  createdById String?
  updatedById String?
  permissions GroupPermission[]
  users       UserGroup[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Permission {
  id          String            @id @default(uuid())
  code        String            @unique
  description String?
  createdById String?
  updatedById String?
  groups      GroupPermission[]
  menus       Menu[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Menu {
  id           String      @id @default(uuid())
  code         String      @unique // e.g. 'home', 'masterData', 'users', 'roles', 'documents', 'reports', 'audit'
  label        String      // e.g. 'หน้าหลัก (Home)'
  icon         String?     // SVG markup or icon identifier
  order        Int         @default(0)
  isActive     Boolean     @default(true)
  adminOnly    Boolean     @default(false)
  parentId     String?
  parent       Menu?       @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  submenus     Menu[]      @relation("MenuHierarchy")
  permissionId String?
  permission   Permission? @relation(fields: [permissionId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model UserGroup {
  userId  String
  groupId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}

model GroupPermission {
  groupId      String
  permissionId String
  group        Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([groupId, permissionId])
}

model Document {
  id            String    @id @default(uuid())
  docNumber     String    @unique
  title         String
  category      String    @default("GENERAL") // GENERAL, FINANCIAL, TECHNICAL, COMPLIANCE
  status        String    @default("DRAFT")   // DRAFT, CONFIRMED, CANCELLED
  content       String?
  authorId      String?
  author        User?     @relation("AuthorDocs", fields: [authorId], references: [id], onDelete: SetNull)
  confirmedById String?
  confirmedBy   User?     @relation("ConfirmedDocs", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  createdById   String?
  updatedById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String   // CREATE, UPDATE, DELETE, CONFIRM, CANCEL, IMPORT, EXPORT
  target    String   // User, Group, Permission, Document
  targetId  String?  // Reference ID of affected entity
  details   String?
  oldValue  String?  // JSON snapshot before change
  newValue  String?  // JSON snapshot after change
  ipAddress String?  @default("127.0.0.1")
  userAgent String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model Company {
  id               String   @id @default(uuid())
  taxId            String   @unique // เลขประจำตัวผู้เสียภาษี 13 หลัก
  branchType       String   @default("HEAD_OFFICE") // HEAD_OFFICE, BRANCH
  branchCode       String   @default("00000") // 00000 = สำนักงานใหญ่ หรือ 00001
  branchName       String   @default("สำนักงานใหญ่")
  commercialRegNo  String?  // เลขทะเบียนพาณิชย์
  nameTh           String   // ชื่อบริษัทภาษาไทย
  nameEn           String   // ชื่อบริษัทภาษาอังกฤษ
  shortName        String?  // ตัวย่อ
  addressTh        String   // ที่อยู่ภาษาไทย
  addressEn        String?  // ที่อยู่ภาษาอังกฤษ
  postalCode       String?  // รหัสไปรษณีย์
  telephone        String?  // โทรศัพท์
  fax              String?  // แฟกซ์
  email            String?  // อีเมล
  website          String?  // เว็บไซต์
  bankName         String?  // ชื่อธนาคาร
  bankBranch       String?  // สาขาธนาคาร
  accountType      String?  // ประเภทบัญชี
  accountName      String?  // ชื่อบัญชี
  accountNumber    String?  // เลขที่บัญชี
  logoUrl          String?  @default("/assets/logo/logo.jpg") // โลโก้บริษัท
  stampUrl         String?  // ตรายางบริษัท
  docFooterNotice  String?  // ข้อความท้ายเอกสาร
  isDefault        Boolean  @default(true) // เป็นบริษัทหลักหรือไม่
  isActive         Boolean  @default(true)
  orgUnits         OrgUnit[]
  positions        Position[]
  createdById      String?
  updatedById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model OrgUnit {
  id          String     @id @default(uuid())
  code        String     @unique // เช่น BR-HQ, DIV-ACC, DEP-ACC01
  name        String // ชื่อภาษาไทย
  nameEn      String?
  type        String // BRANCH, DIVISION, DEPARTMENT, SECTION
  order       Int        @default(0)
  isActive    Boolean    @default(true)
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parentId    String? // null = สาขา (ชั้นบนสุดใต้บริษัท)
  parent      OrgUnit?   @relation("OrgTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    OrgUnit[]  @relation("OrgTree")
  positions   Position[]
  createdById String?
  updatedById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Job {
  id               String        @id @default(uuid())
  code             String        @unique // เช่น JOB-DIV-MGR, JOB-ACC-OFF
  title            String // ผู้จัดการฝ่าย, เจ้าหน้าที่บัญชี
  titleEn          String?
  level            Int           @default(0) // ระดับ/Job Grade
  summary          String? // วัตถุประสงค์ของงาน
  responsibilities String? // หน้าที่ความรับผิดชอบ
  qualifications   String? // คุณสมบัติ
  isActive         Boolean       @default(true)
  positions        Position[]
  documents        JobDocument[]
  createdById      String?
  updatedById      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model JobDocument {
  id            String    @id @default(uuid())
  jobId         String
  job           Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  revisionNo    String    @default("00") // เช่น Rev. 00, Rev. 01, Rev. 02
  fileName      String // เช่น JD_JOB-CEO_Signed_Rev00.pdf
  filePath      String // เช่น uploads/jobs/uuid-filename.pdf
  fileSize      Int? // ขนาดไฟล์เป็นไบต์
  mimeType      String? // application/pdf, image/jpeg, etc.
  effectiveDate DateTime? // วันที่มีผลบังคับใช้
  note          String? // หมายเหตุ / รายละเอียดการลงนาม
  uploadedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Position {
  id           String     @id @default(uuid())
  code         String     @unique // เช่น POS-0001
  title        String // ผู้จัดการฝ่ายบัญชีและการเงิน
  isUnitHead   Boolean    @default(false) // เป็นหัวหน้าของหน่วยงานนี้
  minHeadcount Int        @default(1) // กรอบอัตรากำลังขั้นต่ำ/เป้าหมาย
  maxHeadcount Int        @default(1) // กรอบอัตรากำลังสูงสุด (เช่น 1 หรือ 3-7 คน)
  isActive     Boolean    @default(true)
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  orgUnitId    String? // null = ตำแหน่งระดับบริษัท (CEO)
  orgUnit      OrgUnit?   @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)
  jobId        String
  job          Job        @relation(fields: [jobId], references: [id], onDelete: Restrict)
  reportsToId  String? // สายบังคับบัญชา
  reportsTo    Position?  @relation("ReportLine", fields: [reportsToId], references: [id], onDelete: SetNull)
  subordinates Position[] @relation("ReportLine")
  users        User[]
  createdById  String?
  updatedById  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

