# Database Connection
DATABASE_URL="file:./dev.db"

# JWT Secret & Expiry
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="1d"

# Shared Symmetric AES-256 Key for Frontend <-> Backend Payload Encryption
PAYLOAD_SECRET_KEY="aes-shared-payload-key-secret-2026-v1"

# Server Port
PORT=3000
